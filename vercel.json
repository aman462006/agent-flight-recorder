{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "afrec-api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api/main.py",
      "buildCommand": "pip install -r requirements.txt"
    },
    "dashboard": {
      "root": "dashboard",
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "afrec-api"
      }
    }
  ],
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/"
    }
  ]
}